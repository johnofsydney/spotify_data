# Copy to .env and fill in. .env is gitignored.
# Your Spotify user ID: open your profile in Spotify, Share > Copy link to profile.
SPOTIFY_USER_ID=

# Spotify's "Your All-Time Top Songs" playlist, which it generates per account.
# Open it in Spotify, Share, Copy link — the id is the last path segment.
# Exported and tracked, but scored at zero: Spotify does not keep it current and
# the yearly wraps carry the same information with dates. Leave unset to skip it.
ALLTIME_PLAYLIST_ID=

# The playlist discover_playlist.sh rebuilds each run. Found by this name among
# your own playlists, created if missing, and never counted as taste.
# DISCOVER_PLAYLIST_NAME=Worth Investigating
# DISCOVER_PLAYLIST_TRACKS=2
# DISCOVER_PLAYLIST_PUBLIC=0
