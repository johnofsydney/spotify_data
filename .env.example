# Copy to .env and fill in. .env is gitignored.
# Your Spotify user ID: open your profile in Spotify, Share > Copy link to profile.
SPOTIFY_USER_ID=

# Spotify's "Your All-Time Top Songs" playlist, which it generates per account.
# Open it in Spotify, Share, Copy link — the id is the last path segment.
# This is long-term play data and the strongest signal available; leave unset to
# skip it.
ALLTIME_PLAYLIST_ID=
